#!/bin/bash
set -u
#
# ws_share is a helper script that can be used to grant quickly read or
# read-write access for a workspace to other users or groups based on UNIX ACLs.

# See ws_share --help to get usage information.
#
# Known issues:
#   Changing file or directory permissions after sharing with the standard UNIX
#   commands chmod, etc. after sharing with another user will not modify the
#   rights appropriately for this user. However, you will likely get a message
#   from these tools, e.g.
#     chmod: ... new permissions are ....., not ....
#   A workaround to update permissions is to unshare and re-share the workspace
#   with the users.
#
# Copyright(c) 2021-2024 Christoph Niethammer <niethammer@hlrs.de>
#          (c) Holger Berger 2026
#

progname="$(basename "$0")"
maxmembers=100 # do not share with a group with more than $maxmembers members

# ---------------------------------------------------------------------------
# MCW RCC: NFSv4 ACL backend
#
# Workspaces on NFSv4 mounts (e.g. Qumulo /scratch/g) do not support POSIX
# ACLs (getfacl/setfacl). On those, ws_share uses nfs4_getfacl/nfs4_setfacl/
# nfs4_editfacl and writes NFSv4 ACEs that grant exactly what the upstream
# POSIX entries grant. Mapping (follows the Linux knfsd POSIX<->NFSv4 mapping,
# draft-ietf-nfsv4-acl-mapping):
#
#   POSIX bit           NFSv4 permission letters
#   r                   r   (READ_DATA / LIST_DIRECTORY)
#   w                   wa  (WRITE_DATA, APPEND_DATA) + D (DELETE_CHILD) on dirs
#   x                   x   (EXECUTE / traverse)
#   (always)            tcy (READ_ATTRIBUTES, READ_ACL, SYNCHRONIZE)
#
#   upstream entry                        NFSv4 ACE(s) written
#   user:U:rX  on a directory             A:d:U:rxtcy      (this dir + new subdirs)
#   default:user:U:rX on a directory      A:fi:U:rtcy      (new files, inherit-only)
#   user:U:rX  on a file with any x bit   A::U:rxtcy
#   user:U:rX  on a file without x bits   A::U:rtcy
#   user:U:rwX on a directory             A:d:U:rwaDxtcy
#   default:user:U:rwX on a directory     A:fi:U:rwatcy
#   user:U:rwX on a file with any x bit   A::U:rwaxtcy
#   user:U:rwX on a file without x bits   A::U:rwatcy
#   group:G:...                           same, with the "g" flag added
#   setfacl -x user:U,default:user:U      remove every ACE whose principal is U
#   setfacl -b                            remove every ACE for a named principal
#
# New ACEs are inserted at the front of the ACL, so a named user/group grant
# takes precedence over GROUP@/EVERYONE@ deny entries, as a POSIX named entry
# takes precedence over the group/other class. Symbolic links are skipped, as
# setfacl -R does.
#
# Site settings (environment overrides the defaults below):
#   WS_SHARE_ACL_BACKEND    auto | posix | nfs4   (auto: nfs4 on nfs4 mounts)
#   WS_SHARE_NFS4_IDFORMAT  auto | name | numeric (principal "user@domain" or uid)
#   WS_SHARE_NFS4_DOMAIN    NFSv4 id-mapping domain (default: nfsidmap -d,
#                           then Domain in /etc/idmapd.conf)
# ---------------------------------------------------------------------------
: "${WS_SHARE_ACL_BACKEND:=auto}"
: "${WS_SHARE_NFS4_IDFORMAT:=auto}"
: "${WS_SHARE_NFS4_DOMAIN:=}"

# NFSv4 permission strings for the two upstream access levels (see table)
nfs4_perms() { # <rX|rwX> <dir|file|execfile|newfile>
    local rw=""
    [[ "$1" == "rwX" ]] && rw="wa"
    case "$2" in
        dir)      if [[ -n "$rw" ]]; then echo "rwaDxtcy"; else echo "rxtcy"; fi ;;
        execfile) echo "r${rw}xtcy" ;;
        file|newfile) echo "r${rw}tcy" ;;
    esac
}

# Editor filter used through "EDITOR=$0 nfs4_setfacl -e": nfs4_setfacl writes
# the ACL to a temp file, runs the editor on it and sets the edited result.
# Drops every ACE for the principals listed in _WS_SHARE_NFS4_DROP (lines of
# "u|g <name> <id>"), or for every named principal if it is "*".
nfs4_filter_acl() {
    local file="$1" tmp
    tmp=$(mktemp) || return 1
    awk -v drop="$_WS_SHARE_NFS4_DROP" '
        BEGIN {
            all = (drop == "*")
            n = split(drop, lines, "\n")
            for (i = 1; i <= n; i++) {
                split(lines[i], f, " ")
                if (f[1] == "") continue
                want[f[1] SUBSEP f[2]] = 1
                if (f[3] != "") want[f[1] SUBSEP f[3]] = 1
            }
        }
        /^[ \t]*(#|$)/ { print; next }
        {
            nf = split($0, a, ":")
            if (nf < 4) { print; next }
            who = a[3]
            if (who ~ /@$/) { print; next }          # OWNER@, GROUP@, EVERYONE@, ...
            if (all) next
            kind = (a[2] ~ /g/) ? "g" : "u"
            sub(/@.*/, "", who)
            if ((kind SUBSEP who) in want) next
            print
        }' "$file" > "$tmp" && cat "$tmp" > "$file"
    local rc=$?
    rm -f "$tmp"
    return $rc
}

if [[ -n "${_WS_SHARE_NFS4_DROP:-}" ]]; then
    nfs4_filter_acl "$1"
    exit $?
fi

nfs4_domain() {
    local d="$WS_SHARE_NFS4_DOMAIN"
    if [[ -z "$d" ]] && command -v nfsidmap >/dev/null 2>&1; then
        d=$(nfsidmap -d 2>/dev/null)
    fi
    if [[ -z "$d" && -r /etc/idmapd.conf ]]; then
        d=$(awk -F= 'tolower($1) ~ /^[ \t]*domain[ \t]*$/ { gsub(/[ \t]/, "", $2); print $2; exit }' /etc/idmapd.conf)
    fi
    echo "$d"
}

# principal string for nfs4_setfacl: <u|g> <name>
nfs4_principal() {
    local kind="$1" name="$2" id fmt="$WS_SHARE_NFS4_IDFORMAT" dom
    if [[ "$kind" == "u" ]]; then
        id=$(id -u "$name" 2>/dev/null)
    else
        id=$(getent group "$name" | cut -d: -f3)
    fi
    if [[ "$fmt" == "auto" ]]; then
        dom=$(nfs4_domain)
        if [[ -n "$dom" ]]; then fmt="name"; else fmt="numeric"; fi
    fi
    if [[ "$fmt" == "numeric" ]]; then
        echo "$id"
    else
        [[ -z "${dom:-}" ]] && dom=$(nfs4_domain)
        if [[ -z "$dom" ]]; then
            echo "Error: no NFSv4 id-mapping domain found, set WS_SHARE_NFS4_DOMAIN" >&2
            return 1
        fi
        echo "$name@$dom"
    fi
}

# "u|g <name> <id>" lines for the drop filter
nfs4_drop_list() { # <u|g> name...
    local kind="$1" name id out=""
    shift
    for name in "$@"; do
        if [[ "$kind" == "u" ]]; then
            id=$(id -u "$name" 2>/dev/null)
        else
            id=$(getent group "$name" | cut -d: -f3)
        fi
        out+="$kind $name $id"$'\n'
    done
    printf '%s' "$out"
}

# run the drop filter over the whole workspace tree (no symlinks)
nfs4_drop() { # <drop-spec>
    local self
    self=$(readlink -f "$0")
    find "$WS_PATH" ! -type l -exec env _WS_SHARE_NFS4_DROP="$1" EDITOR="$self" \
        nfs4_setfacl -e {} + >/dev/null
}

# true if any file in the tree has an ACE for one of the principals
nfs4_tree_has() { # <drop-spec>
    find "$WS_PATH" ! -type l -exec nfs4_getfacl {} + 2>/dev/null | awk -v drop="$1" '
        BEGIN { n = split(drop, lines, "\n")
                for (i = 1; i <= n; i++) { split(lines[i], f, " "); if (f[1] == "") continue
                    want[f[1] SUBSEP f[2]] = 1; if (f[3] != "") want[f[1] SUBSEP f[3]] = 1 } }
        /^[ \t]*(#|$)/ { next }
        { if (split($0, a, ":") < 4) next; who = a[3]; if (who ~ /@$/) next
          kind = (a[2] ~ /g/) ? "g" : "u"; sub(/@.*/, "", who)
          if ((kind SUBSEP who) in want) { found = 1; exit } }
        END { exit found ? 0 : 1 }'
}

# grant <rX|rwX> to users (u) or groups (g); replaces earlier grants, like setfacl -m
nfs4_grant() { # <u|g> <rX|rwX> name...
    local kind="$1" access="$2" flag="" p name rc=0
    local spec_dir="" spec_file="" spec_exec="" drop
    shift 2
    [[ "$kind" == "g" ]] && flag="g"
    for name in "$@"; do
        p=$(nfs4_principal "$kind" "$name") || return 1
        spec_dir+="A:d${flag}:$p:$(nfs4_perms "$access" dir),"
        spec_dir+="A:fi${flag}:$p:$(nfs4_perms "$access" newfile),"
        spec_exec+="A:${flag}:$p:$(nfs4_perms "$access" execfile),"
        spec_file+="A:${flag}:$p:$(nfs4_perms "$access" file),"
    done
    drop=$(nfs4_drop_list "$kind" "$@")
    if nfs4_tree_has "$drop"; then
        nfs4_drop "$drop" || rc=1
    fi
    find "$WS_PATH" -type d -exec nfs4_setfacl -a "${spec_dir%,}" {} + || rc=1
    find "$WS_PATH" ! -type d ! -type l -perm /111 -exec nfs4_setfacl -a "${spec_exec%,}" {} + || rc=1
    find "$WS_PATH" ! -type d ! -type l ! -perm /111 -exec nfs4_setfacl -a "${spec_file%,}" {} + || rc=1
    return $rc
}

nfs4_revoke() { # <u|g> name...
    local drop
    drop=$(nfs4_drop_list "$@")
    nfs4_tree_has "$drop" || return 0
    nfs4_drop "$drop"
}

# named grants on the workspace directory: "<user|group> <name> <eff> <dinh> <finh>"
# eff/dinh/finh: "-" (none), "read" or "readwrite"
nfs4_entries() {
    local acl
    acl=$(nfs4_getfacl "$WS_PATH" 2>/dev/null) || return 1
    awk -F: '
        /^[ \t]*(#|$)/ { next }
        $1 != "A" || NF < 4 || $3 ~ /@$/ { next }
        {
            kind = ($2 ~ /g/) ? "group" : "user"
            who = $3; sub(/@.*/, "", who)
            k = kind " " who
            if (!(k in seen)) { seen[k] = 1; order[++n] = k; eff[k] = dinh[k] = finh[k] = "-" }
            lvl = ($4 ~ /w/) ? "readwrite" : "read"
            if ($2 !~ /i/) eff[k] = lvl
            if ($2 ~ /d/) dinh[k] = lvl
            if ($2 ~ /f/) finh[k] = lvl
        }
        END { for (i = 1; i <= n; i++) print order[i], eff[order[i]], dinh[order[i]], finh[order[i]] }
    ' <<<"$acl"
}

# show numeric principals by name when they resolve
nfs4_display_name() { # <user|group> <who>
    local n=""
    if [[ "$2" =~ ^[0-9]+$ ]]; then
        if [[ "$1" == "user" ]]; then n=$(getent passwd "$2" | cut -d: -f1)
        else n=$(getent group "$2" | cut -d: -f1); fi
    fi
    echo "${n:-$2}"
}

# Test for compatible getopt version.
# The parser needs an enhanced version of getopt.
# See man page of getopt for this test.
getopt --test
if [[ $? -ne 4 ]]; then
    echo "Error: $progname needs an enhanced getopt to work."
    exit 1
fi


function usage() {
cat <<EOF
$progname allows to share an existing workspace with other users or groups.

usage:

The following commands share / unshare a workspace (WS_NAME) with users:
 $progname [--readwrite] share [--config CONFIG] [-F FILESYSTEM] WS_NAME USER [USER...]
 $progname [--readwrite] unshare [--config CONFIG] [-F FILESYSTEM] WS_NAME USER [USER...]

With groups:
 $progname [--readwrite] sharegroup [--config CONFIG] [-F FILESYSTEM] WS_NAME GROUP [GROUP...]
 $progname [--readwrite] unsharegroup [--config CONFIG] [-F FILESYSTEM] WS_NAME GROUP [GROUP...]

Remove all ACLs from a workspace:
 $progname unshare-all [--config CONFIG] [-F FILESYSTEM] WS_NAME

List users/groups with ACL entries:
 $progname list [--config CONFIG] WS_NAME

Check share state (ACL consistency) of a workspace:
 $progname check [--config CONFIG] [-F FILESYSTEM] WS_NAME

options:
   -F, --filesystem  ws filesystem
   -h, --help        show this help
       --readwrite   grant read/write instead of read-only access
       --config      config file
       --version

EOF
}

# parse command line
OPTIONS=F:h
LONG_OPTIONS=filesystem:,help,readwrite,config:,yes,version
PARSED=$(getopt --options=$OPTIONS --longoptions=$LONG_OPTIONS --name "$0" -- "$@")
if [[ $? -ne 0 ]]; then
    echo "Error: Command line error"
    usage
    exit 1
fi
eval set -- "$PARSED"
unset PARSED

YES="NO"
ACCESS="rX"  # default: read-only
CONFIG=""
FILESYSTEM=""
answer=""
# parse options
while true; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -F|--filesystem)
            FILESYSTEM="$2"
            shift 2
            ;;
        --config)
            CONFIG="$2"
            shift 2
            ;;
        --readwrite)
            ACCESS="rwX"
            shift
            ;;
	--yes)
	    YES="YES"
	    shift
	    ;;
	--version)
            echo "workspace version 2.0.0"
	    exit 0
	    ;;
        --)
            shift
            break
            ;;
        *)
            echo "Error: Found unknown option"
            usage
            exit 1
            ;;
    esac
done

ACTION="${1:-}"
shift || true
WS_NAME="${1:-}"
shift || true

CALLER_USER=$(id -un)
if [[ "$ACCESS" == "rwX" ]]; then
    ACCESS_STR="readwrite"
else
    ACCESS_STR="read-only"
fi

if [[ -z "$ACTION" ]]; then
    echo "Error: no action specified"
    usage
    exit 1
fi
if [[ -z "$WS_NAME" ]]; then
    echo "Error: workspace name missing"
    usage
    exit 1
fi

# Validate the action before resolving the workspace so that mistakes like
#   ws_share -F gpfs WS usera   (the action was forgotten)
# report the real problem instead of a misleading "Invalid workspace name".
case $ACTION in
    list | share | unshare | sharegroup | unsharegroup | unshare-all | check) ;;
    *)
        echo "Error: Invalid action '$ACTION'. Did you forget to specify an action?"
        usage
        exit 1
        ;;
esac

# Run ws_find with a proper argument array: option values stay intact, the
# workspace name is never word-split or glob-expanded, and a leading-dash name
# cannot be mistaken for an option. (CONFIG_FILE used to be honored here as an
# undocumented ghost hook that silently redirected config resolution.)
FIND_ARGS=()
if [[ -n "$CONFIG" ]]; then FIND_ARGS+=(--config "$CONFIG"); fi
if [[ -n "$FILESYSTEM" ]]; then FIND_ARGS+=(-F "$FILESYSTEM"); fi
WS_PATH=$(ws_find "${FIND_ARGS[@]}" -- "$WS_NAME")
if [[ $? -ne 0 || -z "$WS_PATH" || "$WS_PATH" != /* || "$WS_PATH" == *$'\n'* ]]; then
    echo "Error: Invalid workspace name."
    exit 1
fi

# MCW RCC: pick the ACL backend for this workspace
BACKEND="$WS_SHARE_ACL_BACKEND"
if [[ "$BACKEND" == "auto" ]]; then
    BACKEND="posix"
    if [[ "$(findmnt -n -o FSTYPE -T "$WS_PATH" 2>/dev/null)" == "nfs4" ]]; then
        BACKEND="nfs4"
    fi
fi
case "$BACKEND" in
    posix) ;;
    nfs4)
        if ! command -v nfs4_setfacl >/dev/null 2>&1 || ! command -v nfs4_getfacl >/dev/null 2>&1; then
            echo "Error: $WS_PATH is on NFSv4 but nfs4_getfacl/nfs4_setfacl (nfs4-acl-tools) are not installed"
            exit 1
        fi
        ;;
    *)
        echo "Error: invalid WS_SHARE_ACL_BACKEND '$BACKEND' (auto, posix or nfs4)"
        exit 1
        ;;
esac

if [[ "$BACKEND" == "nfs4" ]]; then
    case $ACTION in
        list)
            nfs4_entries | while read -r kind who eff _ _; do
                [[ "$eff" == "-" ]] && continue
                printf "%-7s %-20s %s\n" "$kind" "$(nfs4_display_name "$kind" "$who")" "$eff"
            done
            exit 0
            ;;
        check)
            ENTRIES=$(nfs4_entries)
            if [[ $? -ne 0 ]]; then
                echo "Error: Failed to read ACLs of $WS_PATH"
                exit 1
            fi
            if [[ -z "$ENTRIES" ]]; then
                echo "Workspace $WS_NAME is not shared with any users or groups."
                exit 0
            fi
            RC=0
            echo "Share state of workspace $WS_NAME:"
            while read -r kind who eff dinh finh; do
                name=$(nfs4_display_name "$kind" "$who")
                if [[ "$eff" == "-" ]]; then
                    echo "Warning: inheritable ACE for $kind $name has no matching effective ACE; existing files are not shared"
                    RC=1
                    continue
                fi
                echo "  $kind $name: $eff"
                if [[ "$dinh" != "$eff" || "$finh" != "$eff" ]]; then
                    echo "Warning: no matching inheritable ACE for $kind $name ($eff); new files will not inherit this access"
                    RC=1
                fi
            done <<<"$ENTRIES"
            if [[ $RC -ne 0 ]]; then
                echo "Error: Inconsistent ACLs detected. A workaround is to unshare and re-share the workspace."
                exit 1
            fi
            exit 0
            ;;
    esac
fi

case $ACTION in
    list)
        # Parse ACL lines by fields. Do NOT substitute on the whole line:
        # usernames/paths may contain substrings like "r-x" (e.g. mean-user-name),
        # and the #-prefixed header lines must not be reported as grants.
        # Note: no -t here; getfacl's test mode emits space-separated entries.
        getfacl -ap "$WS_PATH" | awk -F: \
            '/^(user|group):[^:]+:/ {
                access = (substr($3, 2, 1) == "w") ? "readwrite" : "read"
                printf "%-7s %-20s %s\n", $1, $2, access
            }'
        ;;
    share)
        if [[ $# -eq 0 ]]; then
            echo "Error: No user specified"
            exit 1
        fi
        MACL=""
        for user in "$@"; do
            if ! id "$user" >/dev/null 2>&1; then
                echo "Error: User $user unknown"
                exit 1
            fi
            echo "Granting $ACCESS access for user $user ..."
            MACL+="user:$user:$ACCESS,"
            MACL+="default:user:$user:$ACCESS,"
        done
        if [[ -z "$MACL" ]]; then
            exit 0
        fi
        if [[ "$BACKEND" == "nfs4" ]]; then
            nfs4_grant u "$ACCESS" "$@"
        else
            setfacl -R -m "${MACL%,}" "$WS_PATH"
        fi
        if [[ $? -eq 0 ]]; then
            for user in "$@"; do
                logger -t ws_share -p user.info "Granted $ACCESS_STR access to user <$user> for workspace <$WS_NAME> ($WS_PATH) by <$CALLER_USER>" || true
            done
        else
            echo "Error: Failed to set ACLs"
            exit 1
        fi
        ;;
    unshare)
        if [[ $# -eq 0 ]]; then
            echo "Error: No user specified"
            exit 1
        fi
        XACL=""
        for user in "$@"; do
            if ! id "$user" >/dev/null 2>&1; then
                echo "Error: User $user unknown"
                exit 1
            fi
            echo "Removing access for $user"
            XACL+="user:$user,"
            XACL+="default:user:$user,"
        done
        if [[ -z "$XACL" ]]; then
            exit 0
        fi
        if [[ "$BACKEND" == "nfs4" ]]; then
            nfs4_revoke u "$@"
        else
            setfacl -R -x "${XACL%,}" "$WS_PATH"
        fi
        if [[ $? -eq 0 ]]; then
            for user in "$@"; do
                logger -t ws_share -p user.info "Removed access for user <$user> from workspace <$WS_NAME> ($WS_PATH) by <$CALLER_USER>" || true
            done
        else
            echo "Error: Failed to remove ACLs"
            exit 1
        fi
        ;;
    sharegroup)
        if [[ $# -eq 0 ]]; then
            echo "Error: No group specified"
            exit 1
        fi
        MACL=""
        for group in "$@"; do
            line=$(getent group "$group")
            if [[ -z "$line" ]]; then
                echo "Error: Group $group unknown"
                exit 1
            fi
            # count the members listed in the NSS line (field 4, comma separated); this
            # guardrail is best-effort: backends like LDAP or NIS may return an empty
            # member list for large groups, so say so instead of silently passing
            members="${line#*:*:*:}"
            nmembers=0
            if [[ -n "$members" ]]; then
                nmembers=$(awk -F "," '{print NF}' <<< "$members")
            else
                echo "Warning: cannot verify member count of group $group from NSS"
            fi
            if [[ $nmembers -gt $maxmembers ]] ; then
                echo "Too many members in group, please do not share worldwide"
                exit 1
            fi
            echo "Granting $ACCESS access for group $group ..."
            MACL+="group:$group:$ACCESS,"
            MACL+="default:group:$group:$ACCESS,"
        done
        if [[ -n "$MACL" ]]; then
          if [[ "$ACCESS" == "rwX" ]] ; then
              echo "Warning: giving write access to your group may:"
              echo "  * allow immediate workspace deletion"
              echo "  * interfere with your quota (depending on system setup)"
	      if [[ "$YES" != "YES" ]]; then
		      IFS= read -r -p "Continue (y/N)? " answer
			case "$answer" in
			    [yY]*) ;;
			    *) echo "Aborted."; exit 1 ;;
			esac
	      fi
          fi
          if [[ "$BACKEND" == "nfs4" ]]; then
              nfs4_grant g "$ACCESS" "$@"
          else
              setfacl -R -m "${MACL%,}" "$WS_PATH"
          fi
          if [[ $? -eq 0 ]]; then
              for group in "$@"; do
                  logger -t ws_share -p user.info "Granted $ACCESS_STR access to group <$group> for workspace <$WS_NAME> ($WS_PATH) by <$CALLER_USER>" || true
              done
          else
              echo "Error: Failed to set ACLs"
              exit 1
          fi
        fi
        ;;
    unsharegroup)
        if [[ $# -eq 0 ]]; then
            echo "Error: No group specified"
            exit 1
        fi
        XACL=""
        for group in "$@"; do
            if ! getent group "$group" >/dev/null; then
                echo "Error: Group $group unknown"
                exit 1
            fi
            echo "Removing access for group $group"
            echo "Warning: will produce errors on files not owned by you"
            sleep 3;
            XACL+="group:$group,"
            XACL+="default:group:$group,"
        done
        if [[ -n "$XACL" ]]; then
            if [[ "$BACKEND" == "nfs4" ]]; then
                nfs4_revoke g "$@"
            else
                setfacl -R -x "${XACL%,}" "$WS_PATH"
            fi
            if [[ $? -eq 0 ]]; then
                for group in "$@"; do
                    logger -t ws_share -p user.info "Removed access for group <$group> from workspace <$WS_NAME> ($WS_PATH) by <$CALLER_USER>" || true
                done
            else
                echo "Error: Failed to remove ACLs"
                exit 1
            fi
        fi
        ;;
    unshare-all)
        echo "Warning: will produce errors on files not owned by you"
        sleep 3;
        if [[ "$BACKEND" == "nfs4" ]]; then
            nfs4_drop "*"
        else
            setfacl -R -b "$WS_PATH"
        fi
        if [[ $? -eq 0 ]]; then
            logger -t ws_share -p user.info "Removed all shared access from workspace <$WS_NAME> ($WS_PATH) by <$CALLER_USER>" || true
        else
            echo "Error: Failed to remove all ACLs"
            exit 1
        fi
        ;;
    check)
        ACL=$(getfacl -p "$WS_PATH" 2>/dev/null)
        if [[ $? -ne 0 ]]; then
            echo "Error: Failed to read ACLs of $WS_PATH"
            exit 1
        fi
        # Named entries (those with a user/group name) are the actual share grants.
        # Strip trailing comments (e.g. "#effective:...") so access/default entries
        # can be compared by exact string match.
        ACCESS_ENTRIES=$(grep -E '^(user|group):[^:]+:' <<<"$ACL" | awk '{print $1}')
        DEFAULT_ENTRIES=$(grep -E '^default:(user|group):[^:]+:' <<<"$ACL" | awk '{print $1}')
        if [[ -z "$ACCESS_ENTRIES" && -z "$DEFAULT_ENTRIES" ]]; then
            echo "Workspace $WS_NAME is not shared with any users or groups."
            exit 0
        fi
        RC=0
        echo "Share state of workspace $WS_NAME:"
        while IFS= read -r entry; do
            [[ -z "$entry" ]] && continue
            kind=${entry%%:*}
            rest=${entry#*:}
            name=${rest%%:*}
            perm=${rest#*:}
            if [[ "$perm" == *w* ]]; then pstr="readwrite"; else pstr="read"; fi
            echo "  $kind $name: $pstr"
            # ws_share always sets access and default entries together; a missing
            # default entry means new files will not inherit the grant (e.g. after chmod).
            if ! grep -qxF "default:$entry" <<<"$DEFAULT_ENTRIES"; then
                echo "Warning: no matching default ACL entry for '$entry'; new files will not inherit this access"
                RC=1
            fi
        done <<<"$ACCESS_ENTRIES"
        while IFS= read -r entry; do
            [[ -z "$entry" ]] && continue
            # Orphaned default entry: grants access to new files but not existing ones.
            if ! grep -qxF "${entry#default:}" <<<"$ACCESS_ENTRIES"; then
                echo "Warning: default ACL entry '$entry' has no matching access ACL entry; existing files are not shared"
                RC=1
            fi
        done <<<"$DEFAULT_ENTRIES"
        if [[ $RC -ne 0 ]]; then
            echo "Error: Inconsistent ACLs detected. A workaround is to unshare and re-share the workspace."
            exit 1
        fi
        ;;
    *)
        echo "Error: Invalid action $ACTION"
        usage
        exit 1
esac
